# See https://help.github.com/articles/ignoring-files/ for more about-me ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

AGENTS.md
CLAUDE.md

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS-generated
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride

# secrets / credentials — never commit real keys
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json
serviceAccountKey.json
.npmrc

# logs
*.log
logs/

# caches
.eslintcache
.turbo/
.swc/
.cache/
.nyc_output